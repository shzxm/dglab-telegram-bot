TG_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
TG_OWNER_USER_ID=OWNER_USER_ID_HERE
# Optional: omit to allow the owner's private chat by default.
TG_ALLOWED_CHAT_ID=ALLOWED_CHAT_ID_HERE
DG_DEVICE_MODE=mock
DG_STRENGTH_LIMIT=133
DG_SESSION_DURATION_SECONDS=9999
DG_VOTE_WINDOW_SECONDS=5
DG_ACTION_WINDOW_MS=1000
DG_ACTIONS_PER_WINDOW=3
DG_OBS_HOST=127.0.0.1
DG_OBS_PORT=8787

# Optional iOS app bridge (defaults to loopback only, disabled until a secret is set)
# IOS_BRIDGE_TOKEN=REPLACE_WITH_A_NEW_RANDOM_32_OR_MORE_CHAR_SECRET
# IOS_BRIDGE_HOST=127.0.0.1
# IOS_BRIDGE_PORT=8788
